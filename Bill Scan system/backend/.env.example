# Copy to .env and fill in.

# Which reader extracts bills: vision_api (our local Vision AI) or claude
BILLS_EXTRACTOR=vision_api

# Our Vision API (vision API/start-all.bat starts it on port 8002)
VISION_API_URL=http://127.0.0.1:8002
VISION_API_KEY=sk_live_your_key_here
VISION_API_TIMEOUT=180

# Only for BILLS_EXTRACTOR=claude
ANTHROPIC_API_KEY=
BILLS_MODEL=claude-opus-5
BILLS_EFFORT=medium

BILLS_MAX_UPLOAD=15728640
BILLS_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
