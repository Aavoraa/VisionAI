# Copy to .env and fill in. Never commit .env.

VISION_ENVIRONMENT=development          # development | test | production
VISION_LOG_LEVEL=INFO

# --- Infrastructure (defaults shown are for local development; override in production) ---
VISION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vision_api
VISION_DATABASE_POOL_SIZE=10
VISION_DATABASE_MAX_OVERFLOW=20
VISION_REDIS_URL=redis://localhost:6379/0

# --- Rate limiting (fixed window, per user) ---
VISION_RATE_LIMIT_ENABLED=true
VISION_RATE_LIMIT_REQUESTS=10
VISION_RATE_LIMIT_WINDOW_SECONDS=60
VISION_RATE_LIMIT_FAIL_OPEN=true        # if Redis is down: true = allow, false = 503

# --- Dashboard accounts & sessions ---
# (Empty values mean "default". Never put a trailing comment after an empty value:
#  the .env parser would read the comment as the value.)
# Signup: empty = allowed outside production, disabled in production.
VISION_ALLOW_SIGNUP=
# Secure cookie flag: empty = on in production only (local development uses plain http).
VISION_SESSION_COOKIE_SECURE=
VISION_SESSION_TTL_HOURS=168             # absolute session lifetime
VISION_SESSION_IDLE_TIMEOUT_HOURS=24     # sign out after this long without activity
VISION_LOGIN_RATE_LIMIT_ATTEMPTS=10      # per email per window (per IP: 3x)
VISION_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
VISION_MAX_API_KEYS_PER_USER=25        # active keys per user

# --- Inference ---
# true  = instant deterministic mock (no weights; refused when VISION_ENVIRONMENT=production)
# false = load VISION_MODEL_NAME with transformers (pip install torch torchvision transformers accelerate)
VISION_USE_MOCK_MODEL=true
VISION_MODEL_NAME=HuggingFaceTB/SmolVLM-256M-Instruct
VISION_MODEL_DEVICE=auto                # auto | cpu | cuda
# transformers = load the model in this process; llama_cpp = a GGUF model served by a local
# llama.cpp llama-server (e.g. PaddleOCR-VL for invoices; see README "GGUF models with llama.cpp").
# With llama_cpp, VISION_MODEL_NAME is a label such as PaddleOCR-VL-1.6-GGUF.
VISION_MODEL_BACKEND=transformers
VISION_LLAMA_CPP_URL=http://127.0.0.1:8080
VISION_MODEL_TIMEOUT_SECONDS=120
# Whole-document budget for invoice extraction (many model calls per document).
VISION_INVOICE_TIMEOUT_SECONDS=1800
VISION_MAX_IMAGES_PER_REQUEST=4

# --- Image limits ---
VISION_MAX_IMAGE_BYTES=10485760
VISION_MAX_IMAGE_PIXELS=40000000
VISION_MAX_IMAGE_SIDE=1536
VISION_ALLOWED_IMAGE_FORMATS=["JPEG","PNG","WEBP","GIF"]

# --- Documents (invoice extraction) ---
VISION_MAX_DOCUMENT_BYTES=20971520      # PDF upload limit (20 MB)
VISION_MAX_DOCUMENT_PAGES=10
VISION_MAX_DOCUMENT_SIDE=2560           # pages keep this much resolution (OCR resizes itself)
# Optional reasoning model that cross-checks extracted invoice fields: a second llama-server
# (e.g. Qwen3-VL-2B-Instruct GGUF). Empty = rules only.
VISION_EXTRACTION_LLM_URL=
VISION_EXTRACTION_LLM_NAME=Qwen3-VL-2B-Instruct
VISION_EXTRACTION_LLM_TIMEOUT_SECONDS=300
# Zoomed crops (need the reasoning model, which locates the blocks): read the seller, buyer,
# invoice-details and totals blocks enlarged, and re-read up to N flagged fields (0 = off).
# ZOOM scale caps the enlargement (the OCR model shrinks anything above ~1 megapixel anyway).
VISION_INVOICE_REGION_CROPS=true
VISION_INVOICE_REREAD_MAX_FIELDS=4
VISION_INVOICE_REREAD_SCALE=2.0
# Item rows failing quantity x rate = amount (or not adding up) are read again in shorter bands.
VISION_INVOICE_REREAD_ITEMS=true
# Review routing (heuristic confidence 0-1): >= auto-approve with all checks passed -> approved,
# >= review -> needs review, below -> reprocess.
VISION_INVOICE_AUTO_APPROVE_CONFIDENCE=0.9
VISION_INVOICE_REVIEW_CONFIDENCE=0.7
# Where uploaded invoices and their page images are kept (private; not served directly).
VISION_DOCUMENT_STORAGE_DIR=./data/invoices
# Delete those files after this many days (extracted data is kept). Empty = keep them.
VISION_INVOICE_FILE_RETENTION_DAYS=
# POST each approved invoice to this URL, signed with HMAC-SHA256 (see README). Empty = off.
VISION_INVOICE_WEBHOOK_URL=
VISION_INVOICE_WEBHOOK_SECRET=

# --- Remote fetch policy ---
VISION_FETCH_ALLOWED_SCHEMES=["https","http"]
VISION_FETCH_ALLOWED_PORTS=[80,443]
VISION_FETCH_TOTAL_TIMEOUT=5
VISION_FETCH_MAX_REDIRECTS=3
