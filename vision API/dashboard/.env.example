# Copy to .env.local for local development.

# Where the Next.js server forwards /api/* (the FastAPI backend). Server-side only.
VISION_API_URL=http://localhost:8000

# Public API address shown to users in code examples (e.g. the quick-start snippet).
NEXT_PUBLIC_API_URL=http://localhost:8000

# How long /api/* requests may take, in milliseconds (default 330000 = 5.5 min). Keep it above
# the API's VISION_MODEL_TIMEOUT_SECONDS; raise both for slow CPU inference such as whole-page OCR.
# VISION_PROXY_TIMEOUT_MS=330000
